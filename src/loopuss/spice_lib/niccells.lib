************************************************
* NICCell Library
************************************************
* Model library for loopus2
*
* Copyright 2021 Politecnico di Milano
* 
* Piergiulio Mannocci
* (piergiulio.mannocci [at] polimi [dot] it)
************************************************
* Library Description
************************************************
* NICCell: a subcircuit to model real negative impedances. 
* Models in this library are named following the convention: 
* 
* NICCell_x_y_z where x is the impedance identifier
*						y is the OA gain stage model identifier
*						z is the OA output stage model identifier
* 
* Refer to NonLinearOA for available models. 
************************************************
.subckt niccell_R_gm_y_y_y_y BE TE
RA TE MID {100e3} noiseless
RB MID OUT {100e3} noiseless
RC OUT BE {R} noiseless
XOA BE MID OUT NonLinearOA_gm_y_y_y_y params: GBWP={GBWP}    
.ends niccell_R_gm_y_y_y_y

.subckt niccell_C_gm_y_y_y_y BE TE
RA TE MID {100e3} noiseless
RB MID OUT {100e3} noiseless
CC OUT BE {C}
XOA BE MID OUT NonLinearOA_gm_y_y_y_y params: GBWP={GBWP}    
.ends niccell_C_gm_y_y_y_y

.subckt niccell_RC_gm_y_y_y_y BE TE
RA TE MID {100e3} noiseless
RB MID OUT {100e3} noiseless
RC OUT BE {R} noiseless
CC OUT BE {C}
