************************************************
* Library Description
************************************************
* NonLinearOA: a subcircuit to model nonlinear opamps. 
* Models in this library are named following the convention: 
* 
* NonLinearOA_a_b_c_d_e_f_g where:
*	a is the frequency stage identifier (GM, 1P, 2P or 2P1Z)
*	b is the input offset modifier (Y or O)
*	c is the input impedance identifier (Y or R or C or RC)
*	d is the voltage limit modifier (Y or V)
*	e is the output stage identifier (Y or I or R or IR)
*	f is the noise identifier (noisy)
*	g is the noise modifier (v or in or ip or vin or vip or inip or vinip)
* 
* Individual stages and modifiers are contained in nloa_stages.lib
************************************************
* Begin of autogenerated code:
************************************************
.subckt NonLinearOA_GM_Y_Y_Y_Y INP INN OUT
X1 INN INP NX01 gainstage_gm_y params: GBWP={GBWP}
X5 NX01 OUT outstage_y
.ends NonLinearOA_GM_Y_Y_Y_Y


.subckt NonLinearOA_GM_Y_Y_Y_Y_noisy_v INP INN OUT
X1 INN NXA1 NX01 gainstage_gm_y params: GBWP={GBWP}
X5 NX01 OUT outstage_y
